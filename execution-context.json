{
    "@context": {
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "schema": "https://schema.org/",
        "exec": "https://secorolab.github.io/metamodels/execution-context#",

        "SystemResource": { "@id": "exec:SystemResource" },
        "ResourceWithPath": { "@id": "exec:ResourceWithPath" },
        "Package": { "@id": "exec:Package" },
        "Library": { "@id": "exec:Library" },
        "name": { "@id": "schema:name", "@type": "xsd:string" },
        "description": { "@id": "schema:description", "@type": "xsd:string" },
        "path": { "@id": "exec:path", "@type": "xsd:string" },

        "has-config": { "@id": "exec:has-config", "@type": "@json"  },

        "ExecutionContext": { "@id": "exec:ExecutionContext" },
        "runs-scene": { "@id": "exec:runs-scene", "@type": "@id" },
        "timestep": { "@id": "exec:timestep", "@type": "@id" },

        "RealWorld": { "@id": "exec:RealWorld" },
        "Simulation": { "@id": "exec:Simulation" },

        "platform-name": { "@id": "exec:platform-name", "@type": "xsd:string" },
        "platform-version": { "@id": "exec:platform-version", "@type": "xsd:string" }
    }
}
